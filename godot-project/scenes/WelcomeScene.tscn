[node name="GameText" type="Label" parent="MainScroll/WelcomeContainer/MainVBox/GameExplanationPanel"]
custom_minimum_size = Vector2(500, 0)
layout_mode = 2
text = "LifeQuest turns your daily tasks into a simple game. Complete things in real life, earn XP, level up your character.

Whether it's cleaning your room, calling a friend, or trying a new recipe - every small action becomes progress toward something bigger.

The app suggests tasks that match your current level, so you're never overwhelmed. Start small, build momentum, tackle bigger challenges when you're ready.

No complicated systems or psychology lectures - just you, making progress, one quest at a time."
autowrap_mode = 3

[node name="AlphaExplanationPanel" type="PanelContainer" parent="MainScroll/WelcomeContainer/MainVBox"]
visible = false
layout_mode = 2

[node name="AlphaText" type="Label" parent="MainScroll/WelcomeContainer/MainVBox/AlphaExplanationPanel"]
custom_minimum_size = Vector2(500, 0)
layout_mode = 2
text = "You're testing an early version of LifeQuest - things might be rough around the edges, and some features are still being built.

What works: Quest generation, XP tracking, basic progression. What might break: Some buttons, occasional loading issues, maybe a crash here and there.

Your feedback shapes what gets built next. Found a bug? Great! Wish something worked differently? Tell us! The whole point of alpha testing is finding problems before anyone else sees them.

Thanks for being brave enough to test unfinished software. Your patience and input make LifeQuest better for everyone."
autowrap_mode = 3


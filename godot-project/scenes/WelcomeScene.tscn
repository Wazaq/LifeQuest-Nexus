[node name="GameText" type="Label" parent="MainScroll/WelcomeContainer/MainVBox/GameExplanationPanel"]
custom_minimum_size = Vector2(500, 0)
layout_mode = 2
text = "Are we showing? or are we cached?

LifeQuest turns your daily tasks into a simple game. Complete things in real life, earn XP, level up your character.

Whether it's cleaning your room, calling a friend, or trying a new recipe - every small action becomes progress toward something bigger.

The app suggests tasks that match your current level, so you're never overwhelmed. Start small, build momentum, tackle bigger challenges when you're ready.

No complicated systems or psychology lectures - just you, making progress, one quest at a time."
autowrap_mode = 3

[node name="GameGuidePanel" type="PanelContainer" parent="MainScroll/WelcomeContainer/MainVBox"]
layout_mode = 2

[node name="GameGuideText" type="Label" parent="MainScroll/WelcomeContainer/MainVBox/GameGuidePanel"]
custom_minimum_size = Vector2(500, 0)
layout_mode = 2
text = "Welcome to the tavern, brave adventurer! Here's how your journey works:

*  Visit Dorin in the tavern to receive your next quest - he'll choose one perfectly suited to your current level and growth.

*  Complete quests in real life to earn XP and level up your character. The honor system means you mark your own progress.

*  Progress through five realms based on your psychological growth: Foundation, Safety, Connection, Recognition, and Actualization.

*   Each completed quest brings you closer to becoming the hero of your own life story. Ready to begin your adventure?"
autowrap_mode = 3

[node name="FeaturesPanel" type="PanelContainer" parent="MainScroll/WelcomeContainer/MainVBox"]
layout_mode = 2

[node name="FeaturesText" type="Label" parent="MainScroll/WelcomeContainer/MainVBox/FeaturesPanel"]
custom_minimum_size = Vector2(500, 0)
layout_mode = 2
text = "***  Latest Features ***

*   Beautiful tavern interface with Dorin your friendly tavern keeper
*   Smart quest system that matches your current level and growth
*   Five progression realms based on psychological development
*   Real-world achievement tracking with XP and leveling
*   Mobile-optimized design that works anywhere

Ready to transform your daily life into an epic adventure?"
autowrap_mode = 3

